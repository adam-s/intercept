# Runtime data (browser profiles, cache, logs — all generated at runtime)
/data/*

# Sub-agent worktrees (temporary, per-session)
.claude/worktrees/

# App builder temp spec
prompts/.app-spec.md

# Domain plugins (created by agents, only boardshop is the reference example)
domains/*/
!domains/boardshop/
!domains/youtube/
!domains/reddit/
!domains/hackernews/
!domains/yahoofinance/
!domains/chatgpt/
!domains/nvidia-build
!domains/build-nvidia

# Cached API responses for offline dashboard dev
tmp/cache/

# Haiku's cache directory
.cache/

# Runtime data (logs, cache generated by server at runtime — not source)
apps/api/data/


# Temporary handoff state (not committed)
.claude/tuning-handoff.md
.claude/dashboard-tuning-handoff.md
.agents/user-consent.md

# Route-spec baselines are shape fingerprints only — no captured data.
!/data/route-spec-baseline/
# Grader-held transport keys. Version-controlled because they are durable
# knowledge, not session material — and because a scoring record that lives
# only on one machine cannot be re-verified or corrected.
!/data/answer-keys/
